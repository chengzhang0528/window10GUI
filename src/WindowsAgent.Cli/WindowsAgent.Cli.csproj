<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>win-agent</AssemblyName>
    <RootNamespace>WindowsAgent</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPublishable>true</IsPublishable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Sdcb.SimdPaddleOCR" Version="1.3.0" />
    <PackageReference Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Tiny" Version="1.0.0" />
    <Compile Remove="tests/**/*.cs" />
    <InternalsVisibleTo Include="WindowsAgent.Ocr.Tests" />
    <None Update="licenses/*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
